# Required: Anthropic API key for the agent model (anthropic/claude-sonnet-4-6)
ANTHROPIC_API_KEY=

# Required: Brave Search API key for the mcp-server-brave-search
BRAVE_API_KEY=

# Optional: enables the native Databricks Genie research tool in the agent
DATABRICKS_HOST=
DATABRICKS_AGENT_ID=
DATABRICKS_TOKEN=
DATABRICKS_GENIE_TIMEOUT_SECONDS=300

# Optional: Log level for MCP servers (default: info)
MCP_SERVER_LOG_LEVEL=info
